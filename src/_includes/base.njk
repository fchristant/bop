<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Birds of Paradise" }}</title>
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <header>
    <a href="{{ '/' | url }}">Birds-of-Paradise</a>
    <nav>
      <a href="{{ '/' | url }}">Home</a>
      <a href="{{ '/birds/' | url }}">Birds</a>
      <a href="{{ '/design/' | url }}">Design</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <hr>
    <p>A field guide to the Paradisaeidae.</p>
    <p class="type-label">Distribution maps: occurrence data from <a href="https://www.gbif.org/">GBIF.org</a>, base map from <a href="https://www.naturalearthdata.com/">Natural Earth</a>.</p>
    <p class="type-label">Bird sound recordings courtesy of <a href="https://xeno-canto.org/">Xeno-canto</a> contributors, individually credited on each species page.</p>
  </footer>
  <script src="{{ '/js/audio-player.js' | url }}" defer></script>
</body>
</html>
