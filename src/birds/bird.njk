---
pagination:
  data: birds
  size: 1
  alias: bird
permalink: "/birds/{{ bird.binomial_name | slugify }}/"
layout: base.njk
eleventyComputed:
  title: "{{ bird.common_name }} — Birds of Paradise"
---
<h1>{{ bird.common_name }}</h1>

<p><em lang="la">{{ bird.binomial_name }}</em> &middot; genus <a href="{{ ('/birds/genus/' + (bird.genus | slugify) + '/') | url }}"><span lang="la">{{ bird.genus }}</span></a></p>

<div class="plate">
  {% set mapPath = 'images/maps/' + (bird.binomial_name | slugify) + '.svg' %}
  {% set mapDims = mapPath | svgDimensions %}
  <img class="distribution-map" src="{{ ('/' + mapPath) | url }}" width="{{ mapDims.width }}" height="{{ mapDims.height }}" alt="Distribution map of {{ bird.common_name }}, based on GBIF occurrence records">
  <p class="type-label">Distribution, based on GBIF occurrence records</p>
  <p>
    Found in:
    {% for country in bird.countries %}
    <a href="{{ ('/birds/country/' + (country | slugify) + '/') | url }}">{{ country }}</a>{% if not loop.last %}, {% endif %}
    {% endfor %}
  </p>
</div>

<div class="plate">
  {% if bird.audio %}
  <div class="audio-player" data-audio-player>
    <audio src="{{ ('/audio/' + bird.audio.file) | url }}" preload="metadata"></audio>
    <button type="button" class="audio-player-toggle" aria-label="Play"></button>
    <input type="range" class="audio-player-seek" min="0" max="100" step="0.1" value="0" aria-label="Seek">
    <span class="audio-player-time">0:00 / 0:00</span>
  </div>
  <p class="type-label">
    Recording: {{ bird.audio.type }} &middot;
    <a href="{{ bird.audio.url }}">XC{{ bird.audio.xcId }}</a> by {{ bird.audio.recordist }} &middot;
    <a href="{{ bird.audio.license }}">{{ bird.audio.licenseLabel }}</a>
  </p>
  {% else %}
  <p class="type-label">No recording available yet.</p>
  {% endif %}
</div>

<p><a data-back-link href="{{ '/birds/' | url }}">&larr; Back</a></p>
